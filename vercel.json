{
  "functions": {
    "api/index.js": { "maxDuration": 60, "includeFiles": "{sites*.json,registries.js,footprint.js,lib/**}" }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__p=:path*" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "Referrer-Policy", "value": "no-referrer" }] }
  ]
}
